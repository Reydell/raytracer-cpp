# perfectglasstest: calibrated refraction, transmission, reflection, and highlights
# Intended camera: position (0, 0, 0), forward (0, 0, -1)
# Recommended recursion depth: 6

mtllib scene.mtl

usemtl Floor
plane 0 -1.50 0 0 1 0

# A 7x4 calibration grid behind the glass makes distortion easy to inspect.
v -4.20 -1.50 -10.50
v -3.00 -1.50 -10.50
v -1.80 -1.50 -10.50
v -0.60 -1.50 -10.50
v  0.60 -1.50 -10.50
v  1.80 -1.50 -10.50
v  3.00 -1.50 -10.50
v  4.20 -1.50 -10.50

v -4.20 -0.30 -10.50
v -3.00 -0.30 -10.50
v -1.80 -0.30 -10.50
v -0.60 -0.30 -10.50
v  0.60 -0.30 -10.50
v  1.80 -0.30 -10.50
v  3.00 -0.30 -10.50
v  4.20 -0.30 -10.50

v -4.20  0.90 -10.50
v -3.00  0.90 -10.50
v -1.80  0.90 -10.50
v -0.60  0.90 -10.50
v  0.60  0.90 -10.50
v  1.80  0.90 -10.50
v  3.00  0.90 -10.50
v  4.20  0.90 -10.50

v -4.20  2.10 -10.50
v -3.00  2.10 -10.50
v -1.80  2.10 -10.50
v -0.60  2.10 -10.50
v  0.60  2.10 -10.50
v  1.80  2.10 -10.50
v  3.00  2.10 -10.50
v  4.20  2.10 -10.50

v -4.20  3.30 -10.50
v -3.00  3.30 -10.50
v -1.80  3.30 -10.50
v -0.60  3.30 -10.50
v  0.60  3.30 -10.50
v  1.80  3.30 -10.50
v  3.00  3.30 -10.50
v  4.20  3.30 -10.50

# Bottom checker row.
usemtl GridWhite
f 1 2 10 9
usemtl GridNavy
f 2 3 11 10
usemtl GridWhite
f 3 4 12 11
usemtl GridNavy
f 4 5 13 12
usemtl GridWhite
f 5 6 14 13
usemtl GridNavy
f 6 7 15 14
usemtl GridWhite
f 7 8 16 15

# Colored calibration row through the sphere's center.
usemtl GridNavy
f 9 10 18 17
usemtl GridRed
f 10 11 19 18
usemtl GridCyan
f 11 12 20 19
usemtl GridWhite
f 12 13 21 20
usemtl GridAmber
f 13 14 22 21
usemtl GridGreen
f 14 15 23 22
usemtl GridNavy
f 15 16 24 23

# Upper checker rows.
usemtl GridWhite
f 17 18 26 25
usemtl GridNavy
f 18 19 27 26
usemtl GridWhite
f 19 20 28 27
usemtl GridNavy
f 20 21 29 28
usemtl GridWhite
f 21 22 30 29
usemtl GridNavy
f 22 23 31 30
usemtl GridWhite
f 23 24 32 31

usemtl GridNavy
f 25 26 34 33
usemtl GridWhite
f 26 27 35 34
usemtl GridNavy
f 27 28 36 35
usemtl GridWhite
f 28 29 37 36
usemtl GridNavy
f 29 30 38 37
usemtl GridWhite
f 30 31 39 38
usemtl GridNavy
f 31 32 40 39

# Opaque reference objects reveal the glass reflection component.
usemtl GridRed
S -2.15 -0.90 -5.80 0.55

usemtl GridCyan
S 2.15 -0.90 -5.80 0.55

# Main calibrated glass specimen, 0.05 above the floor.
usemtl OpticalGlass
S 0 -0.20 -5.30 1.25

# Warm key, cool fill, green rim, and neutral frontal lights.
P -4.0  4.5 -0.5 0.82 0.70 0.58
P  4.0  2.5 -2.0 0.28 0.42 0.82
P  0.0  5.0 -8.0 0.18 0.55 0.26
P  0.0 -0.2  0.5 0.24 0.24 0.24
