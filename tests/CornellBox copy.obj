v  -1.01  0.00   0.99
v   1.00  0.00   0.99
v   1.00  0.00  -1.04
v  -0.99  0.00  -1.04

g floor
usemtl floor
f -4 -3 -2 -1

sphere 0 1 -10 5
P 0 1.98 0 1 1 1
P -0.9 1.9 -1 0.07 0.07 0.07
P -0.5 1.9 1.98 0.05 0.05 0.05
