# testskill: glassy icosahedron with colored background objects and lights
# Intended camera: position (0, 0, 0), forward (0, 0, -1)
# Recommended recursion depth: 4 or greater

mtllib scene.mtl

# Neutral surfaces frame the transparent subject.
usemtl Backdrop
plane 0 0 -12 0 0 1

usemtl Floor
plane 0 -1.5 0 0 1 0

# Colored objects behind the icosahedron reveal its refraction.
usemtl Magenta
S -1.55 -0.20 -8.4 0.72

usemtl Emerald
S 0 0.65 -9.0 0.82

usemtl Amber
S 1.55 -0.20 -8.4 0.72

# Glass icosahedron centered at (0, 0, -5).
v -0.8000  1.2944 -5.0000
v  0.8000  1.2944 -5.0000
v -0.8000 -1.2944 -5.0000
v  0.8000 -1.2944 -5.0000
v  0.0000 -0.8000 -3.7056
v  0.0000  0.8000 -3.7056
v  0.0000 -0.8000 -6.2944
v  0.0000  0.8000 -6.2944
v  1.2944  0.0000 -5.8000
v  1.2944  0.0000 -4.2000
v -1.2944  0.0000 -5.8000
v -1.2944  0.0000 -4.2000

usemtl IcosahedronGlass
f 1 12 6
f 1 6 2
f 1 2 8
f 1 8 11
f 1 11 12
f 2 6 10
f 6 12 5
f 12 11 3
f 11 8 7
f 8 2 9
f 4 10 5
f 4 5 3
f 4 3 7
f 4 7 9
f 4 9 10
f 5 10 6
f 3 5 12
f 7 3 11
f 9 7 8
f 10 9 2

# Four colored lights from distinct directions accent the flat glass facets.
P -4.0  4.5 -1.0 1.00 0.18 0.12
P  4.0  2.5 -2.0 0.14 0.36 1.00
P  0.0  5.0 -6.5 0.18 1.00 0.32
P  0.0 -0.5  0.5 1.00 0.42 0.08
