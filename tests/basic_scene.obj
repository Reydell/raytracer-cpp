# Basic scene for the custom OBJ reader.
# Camera: position (0, 1, 3), looking along (0, 0, -1).

# One triangle
v 0.35 0.10 -3.00
v 1.50 0.10 -3.80
v 0.90 1.70 -3.40
f -3 -2 -1

# One sphere: center x y z, followed by radius
sphere -0.90 0.70 -3.50 0.70

# One back plane: origin x y z, followed by normal x y z
plane 0.00 0.00 -6.00 0.00 0.00 1.00

# One white point light: position x y z, followed by color r g b
P 0.00 4.00 1.00 1.00 1.00 1.00
